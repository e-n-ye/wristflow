  "implementation": {
    "sensor": "Native LTR303 ALS; fixed1x/100ms/500ms repeat; existing sensor worker and restore path",
    "formula_source": "Lite-On LTR303/329 Appendix A Rev1.0 22Feb2013 p3-4, manufacturer-authored third-party mirror",
