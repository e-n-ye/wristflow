<screen>
    <view width="390" height="450" scrollable="false" style_bg_color="#bg_black" style_bg_opa="100%" style_border_width="0" style_pad_all="0" style_radius="0" style_text_font="body_20" style_text_color="#fg_primary">
        <lv_button name="app_back" x="18" y="14" width="222" height="52" style_bg_opa="0%" style_border_width="0" style_shadow_width="0" style_pad_all="0"><lv_label name="alarm_back_icon" x="0" y="15" hidden="true" text="&#xf053;" style_text_font="icons_20" /><lv_label name="alarm_title" x="6" y="12" text="闹钟" style_text_font="title_24" /></lv_button>
        <lv_label name="alarm_clock" x="270" y="26" width="96" text="--:--" style_text_font="title_24" style_text_align="right" />
        <lv_obj name="alarm_list_panel" x="0" y="78" width="390" height="350" scrollable="false" style_bg_opa="0%" style_border_width="0" style_pad_all="0">
            <lv_obj name="alarm_list" x="24" y="2" width="342" height="350" scrollbar_mode="off" style_bg_opa="0%" style_border_width="0" style_pad_all="0" style_pad_bottom="16" style_layout="flex" style_flex_flow="column" style_flex_cross_place="center" style_pad_row="8">
                <lv_obj name="alarm_empty_group" width="342" height="269" scrollable="false" style_bg_opa="0%" style_border_width="0" style_pad_all="0">
                    <lv_label name="alarm_empty_icon" x="127" y="70" width="88" text="&#xf0f3;" style_text_font="icons_44" style_text_color="0x008cff" style_text_align="center" />
                    <lv_label name="alarm_empty" x="0" y="154" width="342" text="暂无闹钟" style_text_font="title_24" style_text_color="#fg_primary" style_text_align="center" />
                </lv_obj>
                <alarm_item name="alarm_row_0" hidden="true" />
                <alarm_item name="alarm_row_1" hidden="true" />
                <alarm_item name="alarm_row_2" hidden="true" />
                <alarm_item name="alarm_row_3" hidden="true" />
                <alarm_item name="alarm_row_4" hidden="true" />
                <lv_label name="alarm_list_status" width="342" height="32" hidden="true" text="等待校时" style_text_color="#fg_secondary" style_text_align="center" />
                <lv_label name="alarm_limit" width="342" height="32" hidden="true" text="最多只能设置5个闹钟" style_text_color="#fg_primary" style_text_align="center" />
                <lv_button name="alarm_add" width="150" height="66" style_bg_color="0x008cff" style_radius="33" style_shadow_width="0" style_pad_all="0"><lv_label align="center" text="&#xf067;" style_text_font="icons_44" /></lv_button>
            </lv_obj>
        </lv_obj>
        <time_picker name="alarm_time_panel" hidden="true" />
        <lv_obj name="alarm_settings_panel" x="0" y="78" width="390" height="350" hidden="true" scrollable="false" style_bg_opa="0%" style_border_width="0" style_pad_all="0">

            <lv_button name="alarm_edit_time" x="24" y="2" width="342" height="104" style_bg_color="0x202124" style_radius="24" style_shadow_width="0" style_pad_all="0"><lv_label x="20" y="12" text="时间设置" style_text_font="title_24" /><lv_label name="alarm_draft_time" x="20" y="54" text="07:00" style_text_font="value_36" /></lv_button>
            <lv_button name="alarm_edit_repeat" x="24" y="120" width="342" height="104" style_bg_color="0x202124" style_radius="24" style_shadow_width="0" style_pad_all="0"><lv_label x="20" y="12" text="重复" style_text_font="title_24" /><lv_label name="alarm_draft_rule" x="20" y="57" width="302" text="仅一次" style_text_font="body_20" style_text_color="#fg_secondary" /></lv_button>
            <lv_button name="alarm_delete" x="42" y="279" width="144" height="66" style_bg_color="0x202124" style_radius="33" style_shadow_width="0" style_pad_all="0"><lv_label align="center" text="&#xf1f8;" style_text_font="icons_44" /></lv_button>
            <lv_button name="alarm_save" x="204" y="279" width="144" height="66" style_bg_color="0x008cff" style_radius="33" style_shadow_width="0" style_pad_all="0"><lv_label align="center" text="&#xf00c;" style_text_font="icons_44" /></lv_button>
        </lv_obj>
        <lv_obj name="alarm_repeat_panel" x="0" y="78" width="390" height="350" hidden="true" scrollable="false" style_bg_opa="0%" style_border_width="0" style_pad_all="0">
            <lv_obj name="alarm_repeat_scroll" x="24" y="2" width="342" height="267" scrollbar_mode="off" style_bg_opa="0%" style_border_width="0" style_pad_all="0">
                <alarm_option name="alarm_repeat_0" y="0" label="仅一次" />
                <alarm_option name="alarm_repeat_1" y="88" label="每天" />
                <alarm_option name="alarm_repeat_2" y="176" label="工作日（周一至五）" />
                <alarm_option name="alarm_repeat_3" y="264" label="周末（周六、日）" />
                <alarm_option name="alarm_repeat_4" y="352" label="自定义" />
            </lv_obj>
            <lv_button name="alarm_repeat_accept" x="120" y="279" width="150" height="66" style_bg_color="0x008cff" style_radius="33" style_shadow_width="0" style_pad_all="0"><lv_label align="center" text="&#xf00c;" style_text_font="icons_44" /></lv_button>
        </lv_obj>
        <lv_obj name="alarm_weekdays_panel" x="0" y="78" width="390" height="350" hidden="true" scrollable="false" style_bg_opa="0%" style_border_width="0" style_pad_all="0">
            <lv_obj name="alarm_day_scroll" x="24" y="2" width="342" height="267" scrollbar_mode="off" style_bg_opa="0%" style_border_width="0" style_pad_all="0">
                <alarm_option name="alarm_day_0" y="0" label="周一" />
                <alarm_option name="alarm_day_1" y="88" label="周二" />
                <alarm_option name="alarm_day_2" y="176" label="周三" />
                <alarm_option name="alarm_day_3" y="264" label="周四" />
                <alarm_option name="alarm_day_4" y="352" label="周五" />
                <alarm_option name="alarm_day_5" y="440" label="周六" />
                <alarm_option name="alarm_day_6" y="528" label="周日" />
            </lv_obj>
            <lv_button name="alarm_days_accept" x="120" y="279" width="150" height="66" style_bg_color="0x008cff" style_radius="33" style_shadow_width="0" style_pad_all="0"><lv_label align="center" text="&#xf00c;" style_text_font="icons_44" /></lv_button>
        </lv_obj>
        <lv_label name="alarm_error" x="24" y="330" width="342" hidden="true" text="保存失败" style_text_color="#accent_red" style_text_align="center" />
        <lv_label name="alarm_status" x="24" y="330" width="342" hidden="true" text="等待校时" style_text_color="#fg_secondary" style_text_align="center" />
    </view>
</screen>
