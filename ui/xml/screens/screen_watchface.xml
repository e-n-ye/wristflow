<screen>
	<view
		style_bg_color="#bg_black"
		style_text_color="#fg_primary"
		scrollable="false"
		width="100%"
		height="100%"
	>
		<!-- Top Status & Date Row (Y = 24, Safe Inset) -->
		<lv_obj
			x="#safe_side"
			y="#safe_top"
			width="342"
			height="32"
			scrollable="false"
			style_bg_opa="0%"
		>
			<remove_style_all />

			<!-- Date & Weekday (Left Aligned) -->
			<lv_label
				name="date_label"
				x="0"
				y="4"
				text="9月22日 周二"
				style_text_color="#fg_secondary"
			/>

			<!-- Battery Indicator (Right Aligned) -->
			<lv_obj
				x="262"
				y="2"
				width="80"
				height="24"
				scrollable="false"
				style_bg_opa="0%"
			>
				<remove_style_all />

				<!-- Battery Percent Text -->
				<lv_label
					name="battery_label"
					x="0"
					y="2"
					width="50"
					text="85%"
					style_text_align="right"
					style_text_color="#accent_blue"
				/>

				<!-- Battery Shell Icon -->
				<lv_obj
					x="54"
					y="5"
					width="22"
					height="12"
					scrollable="false"
					style_bg_opa="0%"
					style_border_width="1"
					style_border_color="#accent_blue"
					style_radius="3"
				>
					<remove_style_all />

					<!-- Battery Fill Bar -->
					<lv_obj
						x="2"
						y="2"
						width="14"
						height="6"
						scrollable="false"
						style_bg_color="#accent_blue"
						style_radius="1"
					>
						<remove_style_all />
					</lv_obj>
				</lv_obj>

				<!-- Battery Tip -->
				<lv_obj
					x="76"
					y="9"
					width="2"
					height="4"
					scrollable="false"
					style_bg_color="#accent_blue"
					style_radius="1"
				>
					<remove_style_all />
				</lv_obj>
			</lv_obj>
		</lv_obj>

		<!-- Center Giant Digital Clock Display -->
		<!-- Hours Display (Stacked Large Digits) -->
		<lv_label
			name="hour_label"
			x="0"
			y="80"
			width="100%"
			text="10"
			style_text_align="center"
			style_text_color="#fg_primary"
		/>

		<!-- Minutes Display -->
		<lv_label
			name="minute_label"
			x="0"
			y="220"
			width="100%"
			text="28"
			style_text_align="center"
			style_text_color="#fg_primary"
		/>

		<!-- Bottom 4-Dot Pager Indicator (Y = 425) -->
		<!-- Dot 1: Heart Rate Tile (Inactive) -->
		<lv_obj
			x="165"
			y="#pager_bottom_y"
			width="#pager_dot_size"
			height="#pager_dot_size"
			scrollable="false"
			style_bg_color="#pager_inactive"
			style_radius="#radius_pill"
		>
			<remove_style_all />
		</lv_obj>

		<!-- Dot 2: Watchface (Active) -->
		<lv_obj
			x="179"
			y="#pager_bottom_y"
			width="14"
			height="#pager_dot_size"
			scrollable="false"
			style_bg_color="#pager_active"
			style_radius="#radius_pill"
		>
			<remove_style_all />
		</lv_obj>

		<!-- Dot 3: Activity Tile (Inactive) -->
		<lv_obj
			x="199"
			y="#pager_bottom_y"
			width="#pager_dot_size"
			height="#pager_dot_size"
			scrollable="false"
			style_bg_color="#pager_inactive"
			style_radius="#radius_pill"
		>
			<remove_style_all />
		</lv_obj>

		<!-- Dot 4: System Tile (Inactive) -->
		<lv_obj
			x="213"
			y="#pager_bottom_y"
			width="#pager_dot_size"
			height="#pager_dot_size"
			scrollable="false"
			style_bg_color="#pager_inactive"
			style_radius="#radius_pill"
		>
			<remove_style_all />
		</lv_obj>
	</view>
</screen>
