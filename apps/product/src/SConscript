import os
from building import *
from SCons.Script import ARGUMENTS

Import('SIFLI_SDK')
cwd = GetCurrentDir()
base64 = os.path.join(SIFLI_SDK, 'external/mbedtls')
memsic = os.path.join(SIFLI_SDK, 'customer/peripherals/sensor/mmc36x0kj')
probe = ARGUMENTS.get('resource_probe', '0')
if probe not in ('0', '1'):
    raise ValueError('resource_probe must be 0 or 1')
local_defines = ['WF_RESOURCE_PROBE'] if probe == '1' else []
storage = ARGUMENTS.get('storage_probe', '0')
if storage not in ('0', '1'):
    raise ValueError('storage_probe must be 0 or 1')
if storage == '1':
    if probe == '1':
        raise ValueError('Use only one diagnostic build at a time')
    local_defines += ['WF_STORAGE_PROBE']
objs = DefineGroup('WristFlowProduct', Glob('*.c'), depend=[''],
                   CPPPATH=[cwd, os.path.join(base64, 'include'), os.path.join(cwd, '../../../ui/xml'),
                            os.path.join(cwd, '../../../ui/runtime'), os.path.join(cwd, '../../../core'), memsic],
                   LIBS=[':MemsicAlgo.lib'], LIBPATH=[memsic],
                   CPPDEFINES=['LV_LVGL_H_INCLUDE_SIMPLE'],
                   LOCAL_CPPDEFINES=local_defines,
                   LINKFLAGS=['-Wl,--wrap=BSP_LCD_PowerDown', '-Wl,--wrap=BSP_LCD_PowerUp',
                              '-Wl,--wrap=fal_partition_write', '-Wl,--wrap=fal_partition_erase'],
                   LOCAL_CCFLAGS=' -Wall -Wextra -Werror=implicit-function-declaration')
objs = objs + DefineGroup('WristFlowWeatherBase64', [os.path.join(base64, 'library/base64.c')], depend=[''],
                    CPPPATH=[cwd, os.path.join(base64, 'include')],
                    LOCAL_CPPDEFINES=[('MBEDTLS_CONFIG_FILE', '\\"weather_base64_config.h\\"')])
Return('objs')
