import os, json, hashlib, re
from building import *
from SCons.Script import VariantDir, Dir, ARGUMENTS
Import('SIFLI_SDK')
cwd = GetCurrentDir()
vendor_board = os.path.join(SIFLI_SDK, 'example/boot_loader/project/butterflmicro/board')
variant = os.path.join(Dir('.').abspath, 'vendor_board')
VariantDir(variant, vendor_board, duplicate=0)
# Project owns entry, early hooks and error handling. Never include vendor
# main.c/select_boot(), which can rewrite legacy configuration.
names = ['board.c', 'boot_flash.c', 'efuse.c', 'board_psram.c',
         'sd_emmc_ops.c', 'sd_nand_drv.c', 'sd_nand_ops.c']
sources = Glob('*.c') + [File(os.path.join(variant, name)) for name in names]
root=os.path.normpath(os.path.join(cwd,'../../..'))
defines=[]
includes=[cwd,vendor_board]
binding=ARGUMENTS.get('wf_probe_binding')
receiver=ARGUMENTS.get('wf_receiver_result')
trace = ARGUMENTS.get('wf_boot_trace')
if trace and (trace not in ('1', 'hash-resume') or not receiver):
    raise ValueError('Startup trace requires a receiver-bound boot')
if binding and receiver:
    raise ValueError('Probe and production bindings are mutually exclusive')
if not receiver:
    defines.append('WF_OTA_BOOT_DIAGNOSTIC')
if receiver:
    with open(receiver, encoding='utf-8-sig') as stream:
        record=json.load(stream)
    with open(os.path.join(root, 'sdk.lock.json'), encoding='utf-8') as stream:
        lock = json.load(stream)
    if (record.get('kind') != 'standalone-ota-android-receiver' or record.get('artifact_validation_passed') is not True
            or record.get('board') != lock['board'] or record.get('sdk_commit') != lock['sdk']['commit']
            or record.get('sdk_changes') != []):
        raise ValueError('Verified Android receiver build required')
    [item] = [a for a in record['artifacts'] if os.path.basename(a['path']) == 'main.bin']
    path = os.path.join(os.path.dirname(receiver), 'frozen', 'main.bin')
    with open(path if os.path.isfile(path) else item['path'], 'rb') as stream:
        image = stream.read()
    digest = hashlib.sha256(image).digest()
    if len(image) != item['bytes'] or not 8 <= len(image) <= 0x60000 or digest.hex() != item['sha256']:
        raise ValueError('Receiver differs from bound build')
    with open(os.path.join(root, 'apps/ota_loader/src/original_a.inc'), encoding='ascii') as stream:
        enrollment = bytes(int(v, 16) for v in re.findall(r'0x([0-9a-f]{2}),', stream.read()))
    address = 0x12820000 + image.find(enrollment)
    if len(enrollment) != 336 or image.count(enrollment) != 1 or record.get('original_a_enrollment_address') != address:
        raise ValueError('Missing unique original CycleLog enrollment in the bound receiver')
    # The SDK small SHA-256 implementation preserves its public API and digest.
    # Bulk Product and receiver hashing still uses the native SHA peripheral.
    defines.append('MBEDTLS_SHA256_SMALLER')
    generated = Dir('.').abspath
    with open(os.path.join(generated,'receiver_binding.h'),'w',encoding='ascii') as out:
        out.write('#define WF_RECEIVER_BYTES %du\n' % len(image))
        out.write('#define WF_ORIGINAL_A_ADDRESS 0x%xu\n' % address)
        out.write('static const uint8_t receiver_sha256[32] = {' + ','.join(map(str,digest)) + '};\n')
    includes += [generated, os.path.join(root,'core'), os.path.join(root,'apps/ota_loader/src')]
    for location, files in [('core', ['ota_ab.c','ota_journal.c','ota_trial.c']),
            ('apps/ota_loader/src', ['physical_read.c','release.c','release_hash.c'])]:
        shared = os.path.join(generated, 'ab_' + os.path.basename(location))
        VariantDir(shared,os.path.join(root,location),duplicate=0)
        sources += [File(os.path.join(shared, name)) for name in files]
    if trace:
        includes.append(os.path.join(root,'apps/ota_probe_support'))
        shared = os.path.join(generated,'startup_probe_uart')
        VariantDir(shared, os.path.join(root,'apps/ota_probe_support'),duplicate=0)
        sources += [File(os.path.join(shared,name)) for name in ('uart.c','ota_probe.c')]
        defines += ['WF_OTA_BOOT_TRACE','WF_OTA_PROBE_UART_INIT']
        if trace == 'hash-resume':
            defines += ['WF_OTA_HASH_RESUME_PROBE', 'MBEDTLS_CONFIG_FILE=\\"hash_probe_mbedtls.h\\"']
if binding:
    with open(binding,encoding='utf-8') as stream: item=json.load(stream)
    if item.get('schema')!=1 or item.get('mode')!='literal-probe-only':
        raise ValueError('Only a fixed experimental probe binding is supported')
    tag=item['tag']; probe=item['probe']
    if len(tag)!=4 or any(type(v) is not int or not 0<=v<=0xffffffff for v in tag) or not any(tag):
        raise ValueError('Nonzero128-bit probe tag required')
    with open(probe['path'],'rb') as stream: data=stream.read()
    if not 1024<len(data)<=4096 or probe['bytes']!=len(data) or hashlib.sha256(data).hexdigest()!=probe['sha256']:
        raise ValueError('Bound probe bytes/hash changed')
    marker=probe['marker_address']
    if not 0x12020400<=marker<=0x12020000+len(data)-4:
        raise ValueError('Probe marker outside bound image')
    generated=Dir('.').abspath
    header='/* Generated from an explicit host-checked probe binding. */\n'
    header+='#define WF_OTA_PROBE_BYTES %du\n#define WF_OTA_PROBE_MARKER_ADDRESS 0x%xu\n'%(len(data),marker)
    header+='const uint32_t wf_ota_probe_tag[4]={'+','.join('0x%xu'%v for v in tag)+'};\n'
    header+='const uint8_t wf_ota_probe_expected[WF_OTA_PROBE_BYTES]={'+','.join('0x%02x'%v for v in data)+'};\n'
    with open(os.path.join(generated,'probe_binding.h'),'w',encoding='utf-8',newline='\n') as stream:stream.write(header)
    includes+=[generated,os.path.join(root,'apps/ota_probe_support')]
    shared=os.path.join(generated,'probe_shared')
    VariantDir(shared,os.path.join(root,'apps/ota_probe_support'),duplicate=0)
    sources+=[File(os.path.join(shared,'uart.c')),File(os.path.join(shared,'ota_probe.c'))]
    defines+=['WF_OTA_BOOT_EXECUTE_PROBE','WF_OTA_PROBE_UART_INIT']
group = DefineGroup('WristFlowOtaBoot', sources, depend=[''], CPPPATH=includes,
    CPPDEFINES=defines,
    LINKFLAGS=['-Wl,--undefined=wf_ota_ram_jump','-Wl,-e,Reset_Handler'],
    LOCAL_CCFLAGS=' -Wall -Wextra -Werror=implicit-function-declaration')
Return('group')
