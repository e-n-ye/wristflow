import os
import building
import rtconfig
from building import *
from SCons.Script import ARGUMENTS

receiver = ARGUMENTS.get('wf_android_receiver', '0')
if receiver not in ('0', '1'):
    raise ValueError('wf_android_receiver must be 0 or 1')
os.environ['WRISTFLOW_OTA_RECEIVER'] = receiver
PrepareEnv()
if receiver == '1':
    AddLCPU(os.environ['SIFLI_SDK'], rtconfig.CHIP)
SifliEnv()
TARGET = rtconfig.OUTPUT_DIR + rtconfig.TARGET_NAME + '.' + rtconfig.TARGET_EXT
objs = PrepareBuilding(None)
if receiver == '1':
    # The locked SDK references a shell-only diagnostic flag in app_mem.c.
    # Preserve the shell-free receiver, with those diagnostics off.
    for group in building.Projects:
        if group['name'] == 'lvgl_sifli':
            group['LOCAL_CCFLAGS'] = group.get('LOCAL_CCFLAGS', '') + ' -Dmem_log=0'
    env = GetCurrentEnv()
    env.AppendUnique(CPPPATH=[os.path.abspath('../src')])
    env.Append(CCFLAGS=r' -DLV_KCONFIG_PRESENT -DLV_CONF_PATH=\"ota_lv_conf.h\"')
DoBuilding(TARGET, objs)
# Diagnostic candidate only: no bootloader, FTAB or download scripts are emitted.
