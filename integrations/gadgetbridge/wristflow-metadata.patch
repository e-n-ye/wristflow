+/* SPDX-License-Identifier: AGPL-3.0-or-later
+ * Copyright (C) 2026 WristFlow contributors */
+package nodomain.freeyourgadget.gadgetbridge.service.devices.banglejs;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.nio.charset.StandardCharsets;
+import java.security.GeneralSecurityException;
+import java.security.SecureRandom;
+import java.util.Collections;
+import java.util.Set;
+import java.util.WeakHashMap;
+
+import javax.crypto.Mac;
+import javax.crypto.spec.SecretKeySpec;
+
+import nodomain.freeyourgadget.gadgetbridge.model.WeatherSpec;
+
+/** Optional metadata. Legacy IDs, delete/action handling and weather bytes stay intact. */
+final class WristFlowMetadata {
+    private static final Logger LOG = LoggerFactory.getLogger(WristFlowMetadata.class);
+    static final String PREFS = "wristflow_metadata_v1";
+    static final String SALT = "identity_salt";
+    static final String AQI_SCALE = "gadgetbridge-native";
+    private static final char[] HEX = "0123456789abcdef".toCharArray();
+    private static final Set<SharedPreferences> FAILED_STORES =
+            Collections.newSetFromMap(new WeakHashMap<>());
+
+    private WristFlowMetadata() {}
+
+    static boolean enabled(final boolean buildEnabled, final String deviceName) {
+        return buildEnabled && "Bangle.js WristFlow".equals(deviceName);
+    }
+
+    static void addNotification(final Context context, final JSONObject frame,
+                                final String key, final long when, final String sourcePackage) {
+        // An Android key identifies one notification lifecycle, not a proven QQ person ID.
+        if (key == null || key.isEmpty() || key.getBytes(StandardCharsets.UTF_8).length > 2048) {
+            return;
+        }
+        try {
+            final String token = identity(context, key);
+            if (token == null) return;
+            final JSONObject metadata = new JSONObject();
+            metadata.put("v", 1);
+            metadata.put("notification_key", token);
+            metadata.put("when_present", when > 0);
+            if (when > 0) metadata.put("when_ms", when);
+            if (sourcePackage != null && !sourcePackage.isEmpty()
+                    && sourcePackage.getBytes(StandardCharsets.UTF_8).length <= 255) {
+                metadata.put("package", sourcePackage);
+            }
+            frame.put("wf", metadata);
+            // Never log the raw Android key, salt, sender, title or message body here.
+            LOG.info("WF_META notify id={} key={} when_ms={} package={}",
+                    frame.optInt("id"), token, when > 0 ? when : null,
+                    metadata.optString("package", ""));
+        } catch (GeneralSecurityException | JSONException | RuntimeException e) {
+            // Optional diagnostics must not prevent the original notification from being sent.
+            LOG.warn("WF_META notification metadata unavailable ({})", e.getClass().getSimpleName());
+        }
+    }
+
+    static void addAirQuality(final JSONObject frame, final WeatherSpec.AirQuality airQuality) {
+        try {
+            final boolean present = airQuality != null && airQuality.getAqi() >= 0;
+            final JSONObject metadata = new JSONObject();
+            metadata.put("v", 1);
+            metadata.put("aqi_present", present);
+            metadata.put("aqi_scale", AQI_SCALE);
+            if (present) metadata.put("aqi", airQuality.getAqi());
+            frame.put("wf", metadata);
+            LOG.info("WF_META weather v={} aqi_present={} aqi={} scale={}",
+                    frame.optInt("v"), present, present ? airQuality.getAqi() : null, AQI_SCALE);
+        } catch (JSONException | RuntimeException e) {
+            LOG.warn("WF_META weather metadata unavailable ({})", e.getClass().getSimpleName());
+        }
+    }
+
+    private static synchronized String identity(final Context context, final String key)
+            throws GeneralSecurityException {
+        final SharedPreferences preferences = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+        if (FAILED_STORES.contains(preferences)) return null;
+        String stored = preferences.getString(SALT, null);
+        if (stored == null) {
+            final byte[] generated = new byte[32];
+            new SecureRandom().nextBytes(generated);
+            stored = hex(generated, generated.length);
+            // Persist before using: a failed commit must not create ephemeral group identities.
+            try {
+                if (!preferences.edit().putString(SALT, stored).commit()) {
+                    FAILED_STORES.add(preferences);
+                    return null;
+                }
+            } catch (RuntimeException e) {
+                FAILED_STORES.add(preferences);
+                throw e;
+            }
+        }
+        if (!stored.matches("[0-9a-f]{64}")) return null;
+        final byte[] salt = new byte[32];
+        for (int i = 0; i < salt.length; i++) {
+            salt[i] = (byte) Integer.parseInt(stored.substring(i * 2, i * 2 + 2), 16);
+        }
+        final Mac hmac = Mac.getInstance("HmacSHA256");
+        hmac.init(new SecretKeySpec(salt, "HmacSHA256"));
+        return hex(hmac.doFinal(key.getBytes(StandardCharsets.UTF_8)), 16);
+    }
+
+    private static String hex(final byte[] bytes, final int length) {
+        final char[] result = new char[length * 2];
+        for (int i = 0; i < length; i++) {
+            result[i * 2] = HEX[(bytes[i] & 0xff) >>> 4];
+            result[i * 2 + 1] = HEX[bytes[i] & 15];
+        }
+        return new String(result);
+    }
+}
