@@ -0,0 +1,98 @@
+/* SPDX-License-Identifier: AGPL-3.0-or-later
+ * Copyright (C) 2026 WristFlow contributors */
+package nodomain.freeyourgadget.gadgetbridge.service.devices.banglejs;
+
+import static org.junit.Assert.*;
+import static org.mockito.Mockito.*;
+
+import android.app.Application;
+import android.content.Context;
+import android.content.SharedPreferences;
+import org.json.JSONObject;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.RuntimeEnvironment;
+import org.robolectric.annotation.Config;
+import nodomain.freeyourgadget.gadgetbridge.model.WeatherSpec;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk = 34, application = Application.class)
+public class WristFlowMetadataTest {
+    private Context context;
+
+    @Before public void resetPreferences() {
+        context = RuntimeEnvironment.getApplication();
+        assertTrue(context.getSharedPreferences(WristFlowMetadata.PREFS, 0).edit().clear().commit());
+    }
+
+    @Test public void keepsEntryIdsAndPersistsAnonymousIdentityAcrossUpdates() throws Exception {
+        JSONObject a = new JSONObject("{\"t\":\"notify\",\"id\":11,\"body\":\"A\",\"actions\":[{}]}");
+        JSONObject b = new JSONObject("{\"t\":\"notify\",\"id\":12,\"body\":\"B\"}");
+        WristFlowMetadata.addNotification(context, a, "private-key", 1720000000000L, "com.example.chat");
+        WristFlowMetadata.addNotification(context, b, "private-key", 1720000008000L, "com.example.chat");
+        String token = a.getJSONObject("wf").getString("notification_key");
+        assertTrue(token.matches("[0-9a-f]{32}"));
+        assertFalse(a.toString().contains("private-key"));
+        assertEquals(token, b.getJSONObject("wf").getString("notification_key"));
+        assertEquals(1720000008000L, b.getJSONObject("wf").getLong("when_ms"));
+        assertEquals(11, a.getInt("id")); assertEquals(12, b.getInt("id"));
+        assertEquals("A", a.getString("body")); assertEquals(1, a.getJSONArray("actions").length());
+        JSONObject other = new JSONObject();
+        WristFlowMetadata.addNotification(context, other, "another-key", 0, null);
+        assertNotEquals(token, other.getJSONObject("wf").getString("notification_key"));
+        assertFalse(other.getJSONObject("wf").getBoolean("when_present"));
+        assertFalse(other.getJSONObject("wf").has("when_ms"));
+    }
+
+    @Test public void saltFailureOrMissingKeyLeavesLegacyFrameUsable() throws Exception {
+        JSONObject frame = new JSONObject("{\"t\":\"notify\",\"id\":-42,\"body\":\"A\"}");
+        String original = frame.toString();
+        Context failing = mock(Context.class);
+        SharedPreferences preferences = mock(SharedPreferences.class);
+        SharedPreferences.Editor editor = mock(SharedPreferences.Editor.class);
+        when(failing.getSharedPreferences(WristFlowMetadata.PREFS, 0)).thenReturn(preferences);
+        when(preferences.edit()).thenReturn(editor);
+        when(editor.putString(eq(WristFlowMetadata.SALT), anyString())).thenReturn(editor);
+        when(editor.commit()).thenReturn(false);
+        WristFlowMetadata.addNotification(failing, frame, "key", 1, null);
+        assertEquals(original, frame.toString());
+        // Android can retain a failed commit in memory. Do not use that ephemeral salt later.
+        when(preferences.getString(WristFlowMetadata.SALT, null)).thenReturn("ab".repeat(32));
+        WristFlowMetadata.addNotification(failing, frame, "key", 2, null);
+        assertEquals(original, frame.toString());
+        context.getSharedPreferences(WristFlowMetadata.PREFS, 0).edit()
+                .putString(WristFlowMetadata.SALT, "broken").commit();
+        WristFlowMetadata.addNotification(context, frame, "key", 1, null);
+        WristFlowMetadata.addNotification(context, frame, null, 1, null);
+        WristFlowMetadata.addNotification(context, frame, "x".repeat(2049), 1, null);
+        assertEquals(original, frame.toString());
+    }
+
+    @Test public void missingAqiIsDistinctFromRealZeroWithoutChangingV2Payload() throws Exception {
+        JSONObject frame = new JSONObject("{\"t\":\"weather\",\"v\":2,\"d\":\"unchanged-base64\"}");
+        WristFlowMetadata.addAirQuality(frame, null);
+        assertFalse(frame.getJSONObject("wf").getBoolean("aqi_present"));
+        assertFalse(frame.getJSONObject("wf").has("aqi"));
+        WeatherSpec.AirQuality aqi = new WeatherSpec.AirQuality();
+        WristFlowMetadata.addAirQuality(frame, aqi);
+        assertFalse(frame.getJSONObject("wf").getBoolean("aqi_present"));
+        for (int value : new int[]{0, 47, 700}) {
+            aqi.setAqi(value);
+            WristFlowMetadata.addAirQuality(frame, aqi);
+            assertTrue(frame.getJSONObject("wf").getBoolean("aqi_present"));
+            assertEquals(value, frame.getJSONObject("wf").getInt("aqi"));
+            assertEquals("gadgetbridge-native", frame.getJSONObject("wf").getString("aqi_scale"));
+            assertEquals("unchanged-base64", frame.getString("d"));
+        }
+    }
+
+    @Test public void appliesOnlyToOptedInBuildAndAdvertisedWristFlowName() {
+        assertTrue(WristFlowMetadata.enabled(true, "Bangle.js WristFlow"));
+        assertFalse(WristFlowMetadata.enabled(false, "Bangle.js WristFlow"));
+        assertFalse(WristFlowMetadata.enabled(true, "Bangle.js"));
+        assertFalse(WristFlowMetadata.enabled(true, "WristFlow"));
+        assertFalse(WristFlowMetadata.enabled(true, null));
+    }
+}
